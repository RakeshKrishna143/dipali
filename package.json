{
  "name": "dipali",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prebuild": "npm run content:check && node scripts/prepare-site.mjs",
    "preview": "node scripts/preview.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src e2e playwright.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts e2e *.json *.ts *.js *.md",
    "reference:capture": "node scripts/capture-reference.mjs --screenshots",
    "content:import": "node scripts/import-content.mjs",
    "content:check": "node scripts/check-content.mjs",
    "verify": "npm run lint && npm test -- --watch=false && npm run build",
    "serve:ssr:dipali": "node dist/dipali/server/server.mjs"
  },
  "private": true,
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lucide/angular": "^1.62.0",
    "express": "^5.1.0",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.6.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  }
}
